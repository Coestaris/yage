            VALUE "InternalName",      "app"
            VALUE "OriginalFilename",  "app.exe"
            VALUE "ProductName",       "YAGE Demo Application"
            VALUE "ProductVersion",    "0.0.1.0"
        END
    END

    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
